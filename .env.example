# Copy the block your app needs into apps/<app>/.env — this repo keeps one .env
# per app rather than one at the root, and packages/db keeps its own so Prisma
# CLI commands work without an app loaded. Validated at boot by
# packages/config/src/env.ts.


# ---------------------------------------------------------------------------
# Required everywhere — packages/db/.env, apps/web/.env, apps/docs/.env
# ---------------------------------------------------------------------------

# Neon Postgres. Use the POOLED endpoint (-pooler) for the apps.
# Prisma migrations want the DIRECT endpoint instead; swap it by hand for a
# migrate run, or set DIRECT_URL below.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"


# ---------------------------------------------------------------------------
# Required in BOTH apps — they must hold the identical value
# ---------------------------------------------------------------------------

# Signs the admin's revalidation POSTs; the public app checks them. Minimum 32 characters.
#   openssl rand -hex 32
REVALIDATE_SECRET=""


# ---------------------------------------------------------------------------
# Optional — apps/web
# ---------------------------------------------------------------------------

# The public origin. Defaults to https://www.yatindora.in when unset.
NEXT_PUBLIC_SITE_URL="https://www.yatindora.in"

# Where uploaded images are served from.
NEXT_PUBLIC_CDN_URL="https://cdn.yatindora.in"

# Microsoft Clarity session recording. Both must be set for it to load.
NEXT_PUBLIC_CLARITY_PROJECT_ID=""
NEXT_PUBLIC_ENABLE_CLARITY="false"


# ---------------------------------------------------------------------------
# Optional — apps/web, the contact form. Absent means that one defense is off.
# ---------------------------------------------------------------------------

# Signs the timing token that proves a person spent time on the form. Minimum 32 characters.
#   openssl rand -hex 32
CONTACT_FORM_HMAC_SECRET=""

# Cloudflare Turnstile. Set both or neither.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Where a new-message notification is sent. Falls back to SMTP_EMAIL.
NOTIFY_EMAIL_TO=""

# The admin's origin, for the "Open in admin" link in that notification.
ADMIN_BASE_URL=""


# ---------------------------------------------------------------------------
# Required — apps/docs (the admin)
# ---------------------------------------------------------------------------

# Signs the admin_session cookie (jose HS256, 7-day expiry).
#   openssl rand -hex 32
JWT_SECRET=""

# Gmail app password, not the account password.
# https://myaccount.google.com/apppasswords
SMTP_EMAIL=""
SMTP_PASSWORD=""


# ---------------------------------------------------------------------------
# Optional — BOTH apps, and they must hold the identical value
# ---------------------------------------------------------------------------

# Signs Draft Mode preview links (jose HS256, 30-minute expiry). Unset means
# preview is off in both apps. MUST NOT be the same value as JWT_SECRET.
#   openssl rand -hex 32
PREVIEW_SECRET=""


# ---------------------------------------------------------------------------
# Optional — apps/docs, per-feature. Absent means that feature is off.
# ---------------------------------------------------------------------------

# Referral-email sheet import.
GOOGLE_SHEET_ID=""
GOOGLE_SHEET_TAB=""
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Resume/asset storage reads.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Whether the admin records its own UTM hits.
TRACKING_ENABLED="false"

# Cloudflare R2, for the media manager at /media. Set all four or none; the token
# needs Object Read & Write on this bucket only.
#   Dashboard → R2 → Manage API tokens
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Pins the origin uploaded objects are read from, written into the row at upload
# time. Unset stores a root-relative path, resolved against NEXT_PUBLIC_CDN_URL.
CDN_BASE_URL=""


# ---------------------------------------------------------------------------
# Build-time only
# ---------------------------------------------------------------------------

# ANALYZE=true bun run build  → treemap reports under apps/web/.next/analyze/
ANALYZE="false"
