generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SiteSettings {
  id Int @id @default(1)

  name       String   @default("")
  avatarUrl  String   @default("")
  heroPhotos String[] @default([])
  resumeUrl  String   @default("")

  projectsVersion   SiteVersion @default(v2)
  backgroundVersion SiteVersion @default(v1)

  heroDotColor String  @default("")
  heroDotPulse Boolean @default(true)

  navbarLogo    String @default("")
  copyrightName String @default("")

  contactEmail       String @default("")
  availabilityStatus String @default("")
  availabilityDetail String @default("")

  terrainStrength    Int     @default(50)
  terrainVeil        Int     @default(50)
  terrainCell        Int     @default(12)
  terrainLevels      Int     @default(14)
  terrainMinor       Int     @default(20)
  terrainMajor       Int     @default(48)
  terrainChannel     Boolean @default(true)
  terrainInteractive Boolean @default(true)

  catNapStyle   CatNapStyle @default(TICKS)
  catNapSeconds Int         @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SiteVersion {
  v1
  v2
}

enum CatNapStyle {
  TOOLTIP @map("tooltip")
  RING    @map("ring")
  HALO    @map("halo")
  PIXEL   @map("pixel")
  MOON    @map("moon")
  TICKS   @map("ticks")
  RANDOM  @map("random")
  OFF     @map("off")
}

model HeroContent {
  id      String      @id @default(uuid())
  version SiteVersion @unique
  intro   String      @default("")
  tagline String      @default("")
  live    String?     @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroTitle {
  id        String      @id @default(uuid())
  version   SiteVersion @default(v2)
  title     String
  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([version, sortOrder])
}

model HeroSkillBadge {
  id      String      @id @default(uuid())
  version SiteVersion @default(v2)
  skillId String
  skill   Skill       @relation(fields: [skillId], references: [id], onDelete: Restrict)
  label   String?

  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([version, skillId])
  @@index([version, sortOrder])
  @@index([skillId])
}

model SocialLink {
  id      String       @id @default(uuid())
  version SiteVersion?

  name      String
  href      String
  iconKey   String
  detail    String?
  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([version, sortOrder])
}

model AboutParagraph {
  id        String @id @default(uuid())
  content   String
  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Education {
  id          String     @id @default(uuid())
  institution String
  location    String
  degree      String
  scoreType   ScoreType?
  score       String?
  scoreTotal  String?
  startYear   Int        @map("startYearInt")
  endYear     Int?       @map("endYearInt")
  sortOrder   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ScoreType {
  CGPA
  PERCENTAGE
}

model Skill {
  id         String  @id @default(uuid())
  name       String  @unique
  iconKey    String
  showInGrid Boolean @default(true)
  sortOrder  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experiences ExperienceSkill[]
  projects    ProjectSkill[]
  heroBadges  HeroSkillBadge[]
}

model Experience {
  id        String    @id @default(uuid())
  company   String
  position  String
  location  String
  startedOn DateTime  @db.Date
  endedOn   DateTime? @db.Date
  website   String?

  logoUrl     String?
  logoAssetId String?
  logo        MediaAsset? @relation(fields: [logoAssetId], references: [id], onDelete: SetNull)

  visibleBullets Int @default(4)
  sortOrder      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bullets ExperienceBullet[]
  skills  ExperienceSkill[]

  @@index([logoAssetId])
}

model ExperienceBullet {
  id           String     @id @default(uuid())
  content      String
  sortOrder    Int
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId, sortOrder])
}

model ExperienceSkill {
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  sortOrder    Int

  @@id([experienceId, skillId])
  @@index([experienceId, sortOrder])
  @@index([skillId])
}

model Project {
  id        String  @id @default(uuid())
  title     String
  summary   String
  github    String?
  live      String?
  sortOrder Int

  logoUrl     String?
  logoAssetId String?
  logo        MediaAsset? @relation(fields: [logoAssetId], references: [id], onDelete: SetNull)

  status      ContentStatus @default(DRAFT)
  publishAt   DateTime?
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bullets ProjectBullet[]
  skills  ProjectSkill[]
  gallery ProjectImage[]
  health  ProjectHealth?

  @@index([status, publishAt])
  @@index([status, publishedAt])
  @@index([logoAssetId])
}

model ProjectBullet {
  id        String  @id @default(uuid())
  content   String
  sortOrder Int
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model ProjectSkill {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  sortOrder Int

  @@id([projectId, skillId])
  @@index([projectId, sortOrder])
  @@index([skillId])
}

model ProjectImage {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assetId     String?
  asset       MediaAsset? @relation(fields: [assetId], references: [id], onDelete: Cascade)
  externalUrl String?
  sortOrder   Int

  @@index([projectId, sortOrder])
  @@index([assetId])
}

model ProjectHealth {
  projectId String  @id
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status    LiveProbeStatus?
  latencyMs Int?
  checkedAt DateTime?
}

enum LiveProbeStatus {
  up
  down
}

model Blog {
  id          String @id @default(uuid())
  slug        String @unique
  title       String
  description String
  content     String
  color       String
  sortOrder   Int

  imageOrientation ImageOrientation @default(LANDSCAPE)

  image        String?
  coverAssetId String?
  cover        MediaAsset? @relation(fields: [coverAssetId], references: [id], onDelete: SetNull)

  status      ContentStatus @default(DRAFT)
  publishAt   DateTime?
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishAt])
  @@index([status, publishedAt(sort: Desc)])
  @@index([coverAssetId])
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ImageOrientation {
  LANDSCAPE
  PORTRAIT
  SQUARE
}

model Quote {
  id        String @id @default(uuid())
  quote     String
  author    String
  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactPurpose {
  id        String @id @default(uuid())
  label     String
  emoji     String
  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ContactMessage {
  id      String  @id @default(uuid())
  name    String
  email   String
  purpose String?
  message String

  status  MessageStatus @default(UNREAD)
  starred Boolean       @default(false)

  spamScore   Int      @default(0)
  spamReasons String[] @default([])

  country    String?
  deviceType String?
  browser    String?
  referrer   String?

  notificationMessageId String?

  createdAt DateTime  @default(now())
  readAt    DateTime?
  repliedAt DateTime?
  updatedAt DateTime  @default(now()) @updatedAt

  replies MessageReply[]

  @@index([status, createdAt])
  @@index([starred, createdAt])
  @@index([createdAt])
}

model MessageReply {
  id        String         @id @default(uuid())
  messageId String
  message   ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  subject  String
  bodyHtml String
  bodyText String

  sentById   String?
  sentBy     AdminUser? @relation(fields: [sentById], references: [id], onDelete: SetNull)
  sentByName String?
  sentAt     DateTime   @default(now())

  outboundMessageId String?
  deliveryOk        Boolean @default(false)
  deliveryError     String?

  @@index([messageId, sentAt])
  @@index([sentById])
}

model ReplyTemplate {
  id        String   @id @default(uuid())
  name      String
  subject   String
  bodyHtml  String
  useCount  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
  SPAM
}

model GithubProfile {
  id        String   @id @default(uuid())
  handle    String   @unique
  total     Int      @default(0)
  fetchedAt DateTime

  years GithubYear[]
}

model GithubYear {
  id      String        @id @default(uuid())
  handle  String
  profile GithubProfile @relation(fields: [handle], references: [handle], onDelete: Restrict, onUpdate: Cascade)
  year    Int
  days    String
  spikes  String        @default("")

  @@unique([handle, year])
}

model AdminUser {
  id       String    @id @default(uuid())
  email    String    @unique
  username String    @unique
  password String
  name     String
  role     AdminRole @default(ADMIN)

  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  otp            String?
  otpExpiresAt   DateTime?
  otpAttempts    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditEvents   AuditEvent[]
  mediaUploads  MediaAsset[]
  trackedLinks  TrackedLink[]
  flagChanges   FeatureFlag[]
  replies       MessageReply[]
  revalidations RevalidationLog[]
}

enum AdminRole {
  OWNER
  ADMIN
  SUB_ADMIN
}

model AuditEvent {
  id        String       @id @default(uuid())
  action    AuditAction
  surface   AuditSurface
  createdAt DateTime     @default(now())

  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String
  actorEmail String
  actorRole  AdminRole

  publishState PublishState @default(NONE)
  publishedAt  DateTime?
  publishError String?

  changeCount Int    @default(0)
  summary     String

  changes AuditChange[]

  @@index([createdAt])
  @@index([actorId])
  @@index([publishState, publishedAt])
}

model AuditChange {
  id      String     @id @default(uuid())
  eventId String
  event   AuditEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  seq  Int
  kind AuditChangeKind

  entity      String
  entityLabel String
  rowId       String?
  rowLabel    String?

  field     String
  before    String?
  after     String?
  redacted  Boolean @default(false)
  truncated Boolean @default(false)

  @@index([eventId, seq])
}

enum AuditAction {
  SAVE
  SAVE_AND_PUBLISH
  PUBLISH
}

enum AuditSurface {
  STAGING @map("staging")
  PUBLISH @map("publish")
  SCRIPT  @map("script")
}

enum PublishState {
  NONE
  OK
  FAILED
}

enum AuditChangeKind {
  CREATE
  UPDATE
  DELETE
  REORDER
}

model NoteNode {
  id       String     @id @default(uuid())
  parentId String?
  parent   NoteNode?  @relation("NoteTree", fields: [parentId], references: [id], onDelete: Cascade)
  children NoteNode[] @relation("NoteTree")

  kind  NoteKind
  title String
  slug  String

  path  String @unique
  depth Int    @default(0)

  sortOrder Int @default(0)

  deletedAt DateTime?
  trashRoot Boolean   @default(false)

  answer NoteAnswer?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, sortOrder])
  @@index([deletedAt])
  @@index([path(ops: raw("text_pattern_ops"))], map: "NoteNode_path_prefix_idx")
}

model NoteAnswer {
  nodeId String   @id
  node   NoteNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  body String   @default("")
  tags String[] @default([])

  confidence    Int       @default(0)
  lastRevisedAt DateTime?

  updatedAt DateTime @updatedAt

  @@index([confidence])
  @@index([tags], type: Gin, map: "NoteAnswer_tags_idx")
}

enum NoteKind {
  FOLDER
  QUESTION
}

model MediaAsset {
  id          String  @id @default(uuid())
  key         String  @unique
  url         String
  filename    String
  mimeType    String
  bytes       Int
  width       Int?
  height      Int?
  blurDataUrl String?

  altText String
  folder  String @default("uploads")

  uploadedById String?
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectLogos    Project[]
  projectImages   ProjectImage[]
  experienceLogos Experience[]
  blogCovers      Blog[]

  @@index([createdAt])
  @@index([uploadedById])
  @@index([key(ops: raw("text_pattern_ops"))], map: "MediaAsset_key_prefix_idx")
}

model FeatureFlag {
  key     String  @id
  enabled Boolean @default(true)
  note    String?

  updatedById   String?
  updatedBy     AdminUser? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedByName String?
  updatedAt     DateTime   @updatedAt
  createdAt     DateTime   @default(now())

  @@index([updatedById])
}

model RevalidationLog {
  id      String              @id @default(uuid())
  scope   RevalidationScope?
  paths   String[]
  tags    String[]
  trigger RevalidationTrigger

  entityType String?
  entityId   String?

  actorId   String?
  actor     AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String?

  status     RevalidationStatus
  httpStatus Int?
  durationMs Int
  error      String?
  createdAt  DateTime           @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([actorId])
}

model TagState {
  tag              String   @id
  lastSuccessAt    DateTime
  lastAttemptAt    DateTime
  consecutiveFails Int      @default(0)
}

enum RevalidationScope {
  SITE
  TAGS
  PATHS
  MIXED
}

enum RevalidationTrigger {
  MANUAL
  CONTENT_SAVE
  SCHEDULED_PUBLISH
  FLAG_CHANGE
}

enum RevalidationStatus {
  SUCCESS
  FAILED
  TIMEOUT
}

model AnalyticsSalt {
  dateKey   String   @id
  salt      String
  createdAt DateTime @default(now())
}

model AnalyticsSession {
  id          String @id @default(uuid())
  sessionHash String @unique
  visitorHash String

  channel      String
  rawSource    String?
  rawMedium    String?
  rawCampaign  String?
  rawContent   String?
  rawTerm      String?
  messageId    String?
  referrerHost String?
  landingPath  String
  linkSlug     String?

  country    String?
  region     String?
  city       String?
  deviceType String?
  browser    String?
  os         String?

  startedAt DateTime @default(now())
  pageviews Int      @default(0)

  events AnalyticsEvent[]

  @@index([startedAt])
  @@index([rawContent, startedAt])
}

model AnalyticsEvent {
  id        Int              @id @default(autoincrement())
  sessionId String
  session   AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  type       EventType
  path       String
  section    String?
  label      String?
  durationMs Int?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([sessionId])
}

enum EventType {
  PAGEVIEW
  SECTION_DWELL
}

model TrackedLink {
  id          String  @id @default(uuid())
  slug        String  @unique
  label       String
  channel     String
  campaign    String?
  destination String
  notes       String?

  clickCount  Int       @default(0)
  lastClickAt DateTime?

  active      Boolean    @default(true)
  createdById String?
  createdBy   AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  clicks LinkClick[]

  @@index([createdById])
}

model LinkClick {
  id     Int         @id @default(autoincrement())
  linkId String
  link   TrackedLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  visitorHash  String?
  country      String?
  deviceType   String?
  referrerHost String?
  createdAt    DateTime @default(now())

  @@index([linkId, createdAt])
  @@index([createdAt])
}

model DailyStat {
  date      DateTime @db.Date
  dimension String
  key       String

  pageviews     Int @default(0)
  uniques       Int @default(0)
  sessions      Int @default(0)
  avgDurationMs Int @default(0)
  medianMs      Int @default(0)
  reachedCount  Int @default(0)

  computedAt DateTime @default(now())

  @@id([date, dimension, key])
  @@index([dimension, date])
}

model RollupRun {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  status      String
  rowsWritten Int      @default(0)
  durationMs  Int      @default(0)
  error       String?
  triggeredBy String
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([createdAt])
}

model JobLock {
  key       String   @id
  lockedAt  DateTime
  lockedBy  String
  expiresAt DateTime
}

model MaintenanceState {
  key        String   @id
  lastRunAt  DateTime
  lastResult String?
}

model RateLimitBucket {
  key      String   @id
  count    Int      @default(0)
  windowAt DateTime

  @@index([windowAt])
}
