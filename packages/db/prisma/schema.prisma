generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HeroTitle {
  id        String @id @default(uuid())
  title     String
  sortOrder Int
}

model HeroSkillBadge {
  id        String @id @default(uuid())
  name      String
  iconKey   String
  sortOrder Int
}

model SocialLink {
  id        String  @id @default(uuid())
  name      String
  href      String
  iconKey   String
  detail    String?
  sortOrder Int
}

model AboutParagraph {
  id        String @id @default(uuid())
  content   String
  sortOrder Int
}

model Education {
  id          String     @id @default(uuid())
  institution String
  location    String
  degree      String
  scoreType   ScoreType?
  score       String?
  scoreTotal  String?
  startYear   String
  endYear     String
  sortOrder   Int
}

model Skill {
  id          String       @id @default(uuid())
  name        String
  iconKey     String
  show        Boolean      @default(true)
  sortOrder   Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  experiences Experience[] @relation("ExperienceToSkill")
  projects    Project[]    @relation("ProjectToSkill")
}

model Experience {
  id        String             @id @default(uuid())
  company   String
  position  String
  location  String
  startDate String
  endDate   String
  isCurrent Boolean            @default(false)
  website   String?
  logoUrl   String?
  sortOrder Int
  /// How many bullets the site shows before the "+ N more" toggle. Per-role
  /// because a headline job earns a longer scan layer than a short internship.
  visibleBullets Int           @default(4)
  bullets   ExperienceBullet[]
  skills    Skill[]            @relation("ExperienceToSkill")
}

model ExperienceBullet {
  id           String     @id @default(uuid())
  content      String
  sortOrder    Int
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
}

model Project {
  id        String          @id @default(uuid())
  title     String
  summary   String
  github    String?
  live      String?
  logoUrl   String?
  sortOrder Int
  images    String[]
  bullets   ProjectBullet[]
  skills    Skill[]         @relation("ProjectToSkill")
}

model ProjectBullet {
  id        String  @id @default(uuid())
  content   String
  sortOrder Int
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Blog {
  id               String           @id @default(uuid())
  slug             String           @unique
  title            String
  description      String
  content          String
  image            String
  imageOrientation ImageOrientation @default(LANDSCAPE)
  color            String
  sortOrder        Int
  publishedAt      DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  show             Boolean          @default(true)
}

model Quote {
  id     String @id @default(uuid())
  quote  String
  author String
}

model ContactPurpose {
  id        String @id @default(uuid())
  label     String
  emoji     String
  sortOrder Int
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  purpose   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SiteConfig {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

/// Generic UTM hit log — one row per portfolio page load that arrives with utm_* params.
model UtmTracker {
  id        String   @id @default(uuid())
  source    String? // utm_source     e.g. "email"
  medium    String? // utm_medium     e.g. "referral_outreach"
  campaign  String? // utm_campaign   e.g. "sde1_outreach"
  content   String? // utm_content    e.g. "ZG9yYXlhdGluMUBnbWFpbC5jb20" (base64 -> dorayatin1@gmail.com)
  term      String? // utm_term       e.g. "variant_a"
  messageId String? // mid            e.g. "fa7d6c94-bae7-4086-9a51-5f092f94c921"
  path      String? // landing path   e.g. "/projects"
  referrer  String? // HTTP Referer   e.g. "https://mail.google.com/"
  userAgent String? // raw UA string  e.g. "Mozilla/5.0 ..."
  visitedAt DateTime @default(now()) // server time (UTC)

  @@index([content])
  @@index([campaign])
  @@index([messageId])
  @@index([visitedAt])
}

model AdminUser {
  id             String    @id @default(uuid())
  email          String    @unique
  username       String    @unique
  password       String
  name           String
  role           AdminRole @default(ADMIN)
  failedAttempts Int       @default(0)
  otp            String?
  otpExpiresAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum ScoreType {
  CGPA
  PERCENTAGE
}

enum ImageOrientation {
  LANDSCAPE
  PORTRAIT
  SQUARE
}

enum AdminRole {
  OWNER
  ADMIN
  SUB_ADMIN
}
