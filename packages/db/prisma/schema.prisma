generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One row per hero layout, holding that version's copy and whether it is the
/// one the site serves. Replaces the `heroVersion`, `intro`, `tagline`,
/// `introV2` and `taglineV2` SiteConfig rows: the version a visitor sees is now
/// a column on a real row, so flipping it is an ordinary staged update that
/// commits in the same transaction as the titles and badges it depends on.
///
/// `live` is a nullable string holding the sentinel "live", not a boolean, so
/// "at most one row is live" is a unique index Prisma itself declares — NULLs
/// don't collide in Postgres. A boolean would need a partial index Prisma
/// cannot express, and `@unique` on a boolean would permit only one *non*-live
/// row. Reads stay boolean-shaped: `content.find((c) => c.live)`.
model HeroContent {
  id      String  @id @default(uuid())
  version String  @unique
  intro   String  @default("")
  tagline String  @default("")
  live    String? @unique
}

/// Two hero layouts live side by side, chosen by the HeroContent row that holds
/// `live`. sortOrder is dense *within a version*, so every read of the three
/// models below must carry a version filter — the one exception is the admin's
/// icon-usage lookup, which asks "is this icon used anywhere at all".
model HeroTitle {
  id        String @id @default(uuid())
  title     String
  sortOrder Int
  version   String @default("v2")

  @@index([version, sortOrder])
}

model HeroSkillBadge {
  id        String @id @default(uuid())
  name      String
  iconKey   String
  sortOrder Int
  version   String @default("v2")

  @@index([version, sortOrder])
}

model SocialLink {
  id        String  @id @default(uuid())
  name      String
  href      String
  iconKey   String
  detail    String?
  sortOrder Int
  /// NULL = shown in every version. Nullable here and not above because the
  /// contact section and footer read this table too and stay version-agnostic.
  version   String?

  @@index([version, sortOrder])
}

model AboutParagraph {
  id        String @id @default(uuid())
  content   String
  sortOrder Int
}

model Education {
  id          String     @id @default(uuid())
  institution String
  location    String
  degree      String
  scoreType   ScoreType?
  score       String?
  scoreTotal  String?
  startYear   String
  endYear     String
  sortOrder   Int
}

model Skill {
  id          String       @id @default(uuid())
  name        String
  iconKey     String
  show        Boolean      @default(true)
  sortOrder   Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  experiences Experience[] @relation("ExperienceToSkill")
  projects    Project[]    @relation("ProjectToSkill")
}

model Experience {
  id        String             @id @default(uuid())
  company   String
  position  String
  location  String
  startDate String
  endDate   String
  isCurrent Boolean            @default(false)
  website   String?
  logoUrl   String?
  sortOrder Int
  /// How many bullets the site shows before the "+ N more" toggle. Per-role
  /// because a headline job earns a longer scan layer than a short internship.
  visibleBullets Int           @default(4)
  bullets   ExperienceBullet[]
  skills    Skill[]            @relation("ExperienceToSkill")
}

model ExperienceBullet {
  id           String     @id @default(uuid())
  content      String
  sortOrder    Int
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
}

model Project {
  id        String          @id @default(uuid())
  title     String
  summary   String
  github    String?
  live      String?
  logoUrl   String?
  sortOrder Int
  images    String[]
  bullets   ProjectBullet[]
  skills    Skill[]         @relation("ProjectToSkill")
}

model ProjectBullet {
  id        String  @id @default(uuid())
  content   String
  sortOrder Int
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Blog {
  id               String           @id @default(uuid())
  slug             String           @unique
  title            String
  description      String
  content          String
  image            String
  imageOrientation ImageOrientation @default(LANDSCAPE)
  color            String
  sortOrder        Int
  publishedAt      DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  show             Boolean          @default(true)
}

model Quote {
  id     String @id @default(uuid())
  quote  String
  author String
}

model ContactPurpose {
  id        String @id @default(uuid())
  label     String
  emoji     String
  sortOrder Int
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  purpose   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// Latest snapshot scalars for one GitHub account, feeding the contact section's
/// contribution tile. Separate from GithubYear because `total` is a TRAILING
/// 365-day number from the API, not a calendar-year one — on a year row it would
/// be a category error, and on an old year row it would be meaningless.
///
/// `fetchedAt` is what the tile prints as "as of <date>", and it is the only thing
/// standing between a months-old graph and a false claim about the present. It is
/// written on a successful, validated refresh and on nothing else, so the label
/// can never age past the data it describes.
model GithubProfile {
  id     String @id @default(uuid())
  handle String @unique
  /// Taken verbatim from the API rather than summed from GithubYear: the API's
  /// number is authoritative, and a gap in the archive must not quietly
  /// under-report it.
  total     Int      @default(0)
  fetchedAt DateTime
}

/// One row per calendar year of contribution history — the permanent archive.
/// The upstream mirror only ever serves a trailing 365 days, so a day not captured
/// before it scrolls out of that window is unrecoverable; these rows are the only
/// place the older years will ever exist.
///
/// Keyed to the calendar year and not to the fetch window on purpose. A trailing
/// year slides one day every day, so any offset stored against it drifts and every
/// merge becomes an alignment problem. Jan 1 never moves.
model GithubYear {
  id     String @id @default(uuid())
  handle String
  year   Int
  /// One character per day, index 0 = Jan 1 UTC, counts encoded against the
  /// 64-character alphabet in apps/web/app/lib/github.ts. Length is 365, or 366 in
  /// a leap year, so the string's own length carries the calendar — a
  /// GithubYear_days_length_check CHECK holds it to one of those two.
  days   String
  /// The rare days whose count outruns a single character, as "index:count" pairs.
  /// Empty in almost every year; it exists so the archive is genuinely lossless
  /// rather than lossy in the tail, which is the whole reason for keeping one.
  spikes String @default("")

  @@unique([handle, year])
}

model SiteConfig {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

/// Generic UTM hit log — one row per portfolio page load that arrives with utm_* params.
model UtmTracker {
  id        String   @id @default(uuid())
  source    String? // utm_source     e.g. "email"
  medium    String? // utm_medium     e.g. "referral_outreach"
  campaign  String? // utm_campaign   e.g. "sde1_outreach"
  content   String? // utm_content    e.g. "ZG9yYXlhdGluMUBnbWFpbC5jb20" (base64 -> dorayatin1@gmail.com)
  term      String? // utm_term       e.g. "variant_a"
  messageId String? // mid            e.g. "fa7d6c94-bae7-4086-9a51-5f092f94c921"
  path      String? // landing path   e.g. "/projects"
  referrer  String? // HTTP Referer   e.g. "https://mail.google.com/"
  userAgent String? // raw UA string  e.g. "Mozilla/5.0 ..."
  visitedAt DateTime @default(now()) // server time (UTC)

  @@index([content])
  @@index([campaign])
  @@index([messageId])
  @@index([visitedAt])
}

model AdminUser {
  id             String    @id @default(uuid())
  email          String    @unique
  username       String    @unique
  password       String
  name           String
  role           AdminRole @default(ADMIN)
  failedAttempts Int       @default(0)
  otp            String?
  otpExpiresAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  auditEvents AuditEvent[]
}

/// One row per user gesture in the admin: a Save, a Save & Publish, or a bare
/// Publish. The publish outcome lives on this row rather than a separate one
/// because a Save & Publish is a single gesture whose publish half is allowed
/// to fail without rolling the save back. One entry that can read "saved,
/// publish failed" is the only shape that matches what actually happens.
model AuditEvent {
  id        String   @id @default(uuid())
  /// SAVE | SAVE_AND_PUBLISH | PUBLISH. TEXT with a CHECK rather than a Prisma
  /// enum, the same call the hero-version migration made: a fourth kind later
  /// is one ALTER, with no CREATE TYPE fighting the migration's transaction.
  action    String
  /// Which door the write came through: "staging", "messages", …
  surface   String
  createdAt DateTime @default(now())

  /// Nullable and denormalised: admin accounts are hard-deleted, and the
  /// history has to outlive the account that made it. A required FK would
  /// either block the delete or cascade away exactly what the log exists for.
  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String
  actorEmail String
  /// The role that AUTHORIZED the action, read from the JWT. It can be up to
  /// seven days stale against AdminUser.role, which is why it is stored.
  actorRole  String

  /// NONE | OK | FAILED. NONE on a plain SAVE, and on a SAVE_AND_PUBLISH whose
  /// second round trip never came back.
  publishState String    @default("NONE")
  publishedAt  DateTime?
  publishError String?

  /// Denormalised so the list page never loads children — one reorder can
  /// legitimately carry hundreds of them.
  changeCount Int    @default(0)
  summary     String

  changes AuditChange[]

  @@index([createdAt])
  @@index([actorId])
  @@index([publishState, publishedAt])
}

/// One row per changed FIELD. Creates carry before = null, deletes after =
/// null, and a reorder collapses to a single row holding the two orders.
model AuditChange {
  id      String     @id @default(uuid())
  eventId String
  event   AuditEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Render order within the event — the order the ops were applied in.
  seq  Int
  /// CREATE | UPDATE | DELETE | REORDER
  kind String

  entity      String
  /// "Hero · titles" — the save bar's own label, so the history names a change
  /// the same way the bar named it when it was made.
  entityLabel String
  rowId       String?
  /// What the row IS in human terms, so a deleted row stays legible.
  rowLabel    String?

  field  String
  before String?
  after  String?
  /// A credential changed; the values are deliberately absent.
  redacted  Boolean @default(false)
  /// The stored value is a window around the first divergence, not the whole
  /// field.
  truncated Boolean @default(false)

  @@index([eventId, seq])
  @@index([entity, rowId])
}

/// Private admin notes. Never published, never staged — this tree does not
/// appear on the public site and is deliberately absent from staging.ts's
/// `Entity` union. Nothing in apps/web reads it.
model NoteNode {
  id       String     @id @default(uuid())
  parentId String?
  parent   NoteNode?  @relation("NoteTree", fields: [parentId], references: [id], onDelete: Cascade)
  children NoteNode[] @relation("NoteTree")

  kind  NoteKind
  title String
  slug  String

  /// Materialised ancestry: "/dsa/graphs/dijkstra". Denormalised from parentId
  /// and rewritten on rename/move. `parentId` stays the source of truth for
  /// structure; this is an index over it, so cycle checks and subtree scopes
  /// are string comparisons rather than recursive queries.
  ///
  /// Unique — which is ALSO what stops two root folders sharing a name.
  /// @@unique([parentId, slug]) cannot do that, because Postgres treats NULL
  /// parentIds as distinct and every root row has one.
  path  String @unique
  depth Int    @default(0)

  sortOrder Int @default(0)

  /// Soft delete. A trashed folder takes its subtree with it; `trashRoot` marks
  /// the node that was explicitly trashed so restore knows where to start, and
  /// so Trash lists the gesture rather than every row it swept up.
  deletedAt DateTime?
  trashRoot Boolean   @default(false)

  answer NoteAnswer?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, sortOrder])
  @@index([deletedAt])
}

/// Split from NoteNode so "load the whole tree" stays a narrow query — the
/// sidebar renders hundreds of rows and never reads an answer body.
model NoteAnswer {
  nodeId String   @id
  node   NoteNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  body String   @default("")
  tags String[] @default([])

  /// 0 unrated · 1 again · 2 shaky · 3 good · 4 solid. Drives the revise queue.
  confidence    Int       @default(0)
  lastRevisedAt DateTime?

  updatedAt DateTime @updatedAt

  @@index([confidence])
}

enum NoteKind {
  FOLDER
  QUESTION
}

enum ScoreType {
  CGPA
  PERCENTAGE
}

enum ImageOrientation {
  LANDSCAPE
  PORTRAIT
  SQUARE
}

enum AdminRole {
  OWNER
  ADMIN
  SUB_ADMIN
}
