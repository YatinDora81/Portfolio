generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HeroContent {
  id      String  @id @default(uuid())
  version String  @unique
  intro   String  @default("")
  tagline String  @default("")
  live    String? @unique
}

model HeroTitle {
  id        String @id @default(uuid())
  title     String
  sortOrder Int
  version   String @default("v2")

  @@index([version, sortOrder])
}

model HeroSkillBadge {
  id        String @id @default(uuid())
  name      String
  iconKey   String
  sortOrder Int
  version   String @default("v2")

  @@index([version, sortOrder])
}

model SocialLink {
  id        String  @id @default(uuid())
  name      String
  href      String
  iconKey   String
  detail    String?
  sortOrder Int
  version   String?

  @@index([version, sortOrder])
}

model AboutParagraph {
  id        String @id @default(uuid())
  content   String
  sortOrder Int
}

model Education {
  id          String     @id @default(uuid())
  institution String
  location    String
  degree      String
  scoreType   ScoreType?
  score       String?
  scoreTotal  String?
  startYear   String
  endYear     String
  sortOrder   Int
}

model Skill {
  id          String       @id @default(uuid())
  name        String
  iconKey     String
  show        Boolean      @default(true)
  sortOrder   Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  experiences Experience[] @relation("ExperienceToSkill")
  projects    Project[]    @relation("ProjectToSkill")
}

model Experience {
  id        String             @id @default(uuid())
  company   String
  position  String
  location  String
  startDate String
  endDate   String
  isCurrent Boolean            @default(false)
  website   String?
  logoUrl   String?
  sortOrder Int
  visibleBullets Int           @default(4)
  bullets   ExperienceBullet[]
  skills    Skill[]            @relation("ExperienceToSkill")
}

model ExperienceBullet {
  id           String     @id @default(uuid())
  content      String
  sortOrder    Int
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
}

model Project {
  id        String          @id @default(uuid())
  title     String
  summary   String
  github    String?
  live      String?
  logoUrl   String?
  sortOrder Int
  images    String[]
  bullets   ProjectBullet[]
  skills    Skill[]         @relation("ProjectToSkill")

  status      ContentStatus   @default(DRAFT)
  publishAt   DateTime?
  publishedAt DateTime?
  updatedAt   DateTime        @updatedAt

  @@index([status, publishAt])
  @@index([status, publishedAt])
}

model ProjectBullet {
  id        String  @id @default(uuid())
  content   String
  sortOrder Int
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Blog {
  id               String           @id @default(uuid())
  slug             String           @unique
  title            String
  description      String
  content          String
  image            String
  imageOrientation ImageOrientation @default(LANDSCAPE)
  color            String
  sortOrder        Int
  publishedAt      DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  show             Boolean          @default(true)

  status           ContentStatus  @default(DRAFT)
  publishAt        DateTime?

  @@index([status, publishAt])
  @@index([status, publishedAt])
}

model Quote {
  id     String @id @default(uuid())
  quote  String
  author String
}

model ContactPurpose {
  id        String @id @default(uuid())
  label     String
  emoji     String
  sortOrder Int
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  purpose   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  status  MessageStatus @default(UNREAD)
  starred Boolean       @default(false)

  spamScore   Int      @default(0)
  spamReasons String[] @default([])

  country    String?
  deviceType String?
  browser    String?
  referrer   String?

  notificationMessageId String?

  readAt    DateTime?
  repliedAt DateTime?
  updatedAt DateTime  @default(now()) @updatedAt

  replies MessageReply[]

  @@index([status, createdAt])
  @@index([starred, createdAt])
  @@index([createdAt])
}

model MessageReply {
  id        String         @id @default(uuid())
  messageId String
  message   ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  subject  String
  bodyHtml String
  bodyText String

  sentById String?
  sentAt   DateTime @default(now())

  outboundMessageId String?
  deliveryOk        Boolean @default(false)
  deliveryError     String?

  @@index([messageId, sentAt])
}

model ReplyTemplate {
  id        String   @id @default(uuid())
  name      String
  subject   String
  bodyHtml  String
  useCount  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RateLimitBucket {
  key      String   @id
  count    Int      @default(0)
  windowAt DateTime

  @@index([windowAt])
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
  SPAM
}

model GithubProfile {
  id     String @id @default(uuid())
  handle String @unique
  total     Int      @default(0)
  fetchedAt DateTime
}

model GithubYear {
  id     String @id @default(uuid())
  handle String
  year   Int
  /// one char per day, index 0 = jan 1 utc
  days   String
  /// rare high days as "index:count" pairs
  spikes String @default("")

  @@unique([handle, year])
}

model SiteConfig {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model UtmTracker {
  id        String   @id @default(uuid())
  source    String?
  medium    String?
  campaign  String?
  content   String?
  term      String?
  messageId String?
  path      String?
  referrer  String?
  userAgent String?
  visitedAt DateTime @default(now())

  @@index([content])
  @@index([campaign])
  @@index([messageId])
  @@index([visitedAt])
}

model AdminUser {
  id             String    @id @default(uuid())
  email          String    @unique
  username       String    @unique
  password       String
  name           String
  role           AdminRole @default(ADMIN)
  failedAttempts Int       @default(0)
  otp            String?
  otpExpiresAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  auditEvents AuditEvent[]
}

model AuditEvent {
  id        String   @id @default(uuid())
  /// SAVE | SAVE_AND_PUBLISH | PUBLISH
  action    String
  /// where the write came from: "staging", "messages"
  surface   String
  createdAt DateTime @default(now())

  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String
  actorEmail String
  actorRole  String

  /// NONE | OK | FAILED
  publishState String    @default("NONE")
  publishedAt  DateTime?
  publishError String?

  changeCount Int    @default(0)
  summary     String

  changes AuditChange[]

  @@index([createdAt])
  @@index([actorId])
  @@index([publishState, publishedAt])
}

model AuditChange {
  id      String     @id @default(uuid())
  eventId String
  event   AuditEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  seq  Int
  /// CREATE | UPDATE | DELETE | REORDER
  kind String

  entity      String
  entityLabel String
  rowId       String?
  rowLabel    String?

  field  String
  before String?
  after  String?
  redacted  Boolean @default(false)
  /// value is a window around the first divergence
  truncated Boolean @default(false)

  @@index([eventId, seq])
  @@index([entity, rowId])
}

model NoteNode {
  id       String     @id @default(uuid())
  parentId String?
  parent   NoteNode?  @relation("NoteTree", fields: [parentId], references: [id], onDelete: Cascade)
  children NoteNode[] @relation("NoteTree")

  kind  NoteKind
  title String
  slug  String

  /// materialised ancestry: "/dsa/graphs/dijkstra"
  path  String @unique
  depth Int    @default(0)

  sortOrder Int @default(0)

  deletedAt DateTime?
  trashRoot Boolean   @default(false)

  answer NoteAnswer?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, sortOrder])
  @@index([deletedAt])
}

model NoteAnswer {
  nodeId String   @id
  node   NoteNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  body String   @default("")
  tags String[] @default([])

  /// 0 unrated, 1 again, 2 shaky, 3 good, 4 solid
  confidence    Int       @default(0)
  lastRevisedAt DateTime?

  updatedAt DateTime @updatedAt

  @@index([confidence])
}

enum NoteKind {
  FOLDER
  QUESTION
}

enum ScoreType {
  CGPA
  PERCENTAGE
}

enum ImageOrientation {
  LANDSCAPE
  PORTRAIT
  SQUARE
}

enum AdminRole {
  OWNER
  ADMIN
  SUB_ADMIN
}

model JobLock {
  key       String   @id
  lockedAt  DateTime
  lockedBy  String
  expiresAt DateTime

  @@index([expiresAt])
}

model RevalidationLog {
  id         String              @id @default(uuid())
  paths      String[]
  tags       String[]
  trigger    RevalidationTrigger
  entityType String?
  entityId   String?
  actorId    String?
  status     RevalidationStatus
  httpStatus Int?
  durationMs Int
  error      String?
  createdAt  DateTime            @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([entityType, entityId])
}

model TagState {
  tag              String   @id
  lastSuccessAt    DateTime
  lastAttemptAt    DateTime
  consecutiveFails Int      @default(0)
}

enum RevalidationTrigger {
  MANUAL
  CONTENT_SAVE
  SCHEDULED_PUBLISH
  FLAG_CHANGE
  SYSTEM
}

enum RevalidationStatus {
  SUCCESS
  FAILED
  TIMEOUT
}

model FeatureFlag {
  key         String   @id
  label       String
  description String?
  enabled     Boolean  @default(true)
  note        String?
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model AnalyticsSalt {
  dateKey   String   @id
  salt      String
  createdAt DateTime @default(now())
}

model AnalyticsSession {
  id          String @id @default(uuid())
  sessionHash String @unique
  visitorHash String

  channel      String
  rawSource    String?
  rawMedium    String?
  rawCampaign  String?
  referrerHost String?
  landingPath  String
  linkSlug     String?

  country    String?
  region     String?
  city       String?
  deviceType String?
  browser    String?
  os         String?

  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  pageviews  Int      @default(0)

  events AnalyticsEvent[]

  @@index([startedAt])
  @@index([channel, startedAt])
  @@index([visitorHash, startedAt])
}

model AnalyticsEvent {
  id        Int              @id @default(autoincrement())
  sessionId String
  session   AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  type       EventType
  path       String
  section    String?
  label      String?
  durationMs Int?
  meta       Json?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([sessionId])
  @@index([section, createdAt])
}

enum EventType {
  PAGEVIEW
  SECTION_DWELL
  CLICK
  RESUME_OPEN
  OUTBOUND
}

model TrackedLink {
  id          String  @id @default(uuid())
  slug        String  @unique
  label       String
  channel     String
  campaign    String?
  destination String
  notes       String?

  clickCount  Int       @default(0)
  lastClickAt DateTime?

  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clicks LinkClick[]

  @@index([channel, createdAt])
  @@index([active, createdAt])
}

model LinkClick {
  id     Int         @id @default(autoincrement())
  linkId String
  link   TrackedLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  visitorHash  String?
  country      String?
  deviceType   String?
  referrerHost String?
  createdAt    DateTime @default(now())

  @@index([linkId, createdAt])
  @@index([createdAt])
}

model DailyStat {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  dimension String
  key       String

  pageviews     Int @default(0)
  uniques       Int @default(0)
  sessions      Int @default(0)
  avgDurationMs Int @default(0)
  medianMs      Int @default(0)
  reachedCount  Int @default(0)

  computedAt DateTime @default(now())

  @@unique([date, dimension, key])
  @@index([date])
  @@index([dimension, date])
}

model RollupRun {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  status      String
  rowsWritten Int      @default(0)
  durationMs  Int      @default(0)
  error       String?
  triggeredBy String
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([createdAt])
}

model MaintenanceState {
  key        String   @id
  lastRunAt  DateTime
  lastResult String?
}

model MediaAsset {
  id          String  @id @default(uuid())
  key         String  @unique
  url         String
  filename    String
  mimeType    String
  bytes       Int
  width       Int?
  height      Int?
  blurDataUrl String?

  altText String
  folder  String @default("uploads")

  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([folder, createdAt])
  @@index([createdAt])
}
