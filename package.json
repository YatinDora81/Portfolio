{
  "name": "portfolio",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "postinstall": "bun run --cwd packages/db db:generate"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "bun@1.3.7",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
